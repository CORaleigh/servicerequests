<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the server-side configuration file.

  Copy this to the deployed application folder as "cw-secrets.config" and fill
  in the values for THAT server. Do NOT commit the filled-in copy, and do NOT
  include it in a deploy — web.config references it via
  <appSettings file="cw-secrets.config">, so leaving it out of the deploy is
  what keeps these values from being overwritten by each publish.

  This file holds everything that differs between servers, which is why the
  same build can be deployed to test and production unchanged.

  CW_AUTH_URL must point at the SAME Cityworks instance that hosts the app.
  The app calls the Cityworks API on its own host at a root-relative path, so
  if CW_AUTH_URL names a different instance the app authenticates against one
  and then sends that token to another, and every API call fails with a 401.

  It also determines the API path the browser is told to use: token.ashx takes
  the part of CW_AUTH_URL before "/Services/" and hands the app that prefix.
  Production serves the API from /admin/, the test instance from /backdoor/,
  and setting the auth URL correctly is all that is needed to follow either.

    Production   https://cityworks.raleighnc.gov/admin/Services/General/Authentication/Authenticate
                 → API calls go to /admin/Services/AMS/

    Test         https://cityworkstest.raleighnc.gov/backdoor/Services/General/Authentication/Authenticate
                 → API calls go to /backdoor/Services/AMS/

  CW_API_BASE overrides that derivation for an instance that does not follow
  the layout above. Leave it out unless you need it; a value that disagrees
  with CW_AUTH_URL is exactly the misconfiguration the derivation prevents.
-->
<appSettings>
  <add key="CW_USERNAME" value="" />
  <add key="CW_PASSWORD" value="" />
  <add key="CW_AUTH_URL" value="" />
  <!-- <add key="CW_API_BASE" value="/backdoor/Services/AMS/" /> -->
</appSettings>
