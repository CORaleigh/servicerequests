<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the server-side credential file.

  Copy this to the deployed application folder as "cw-secrets.config" and fill
  in the real Cityworks service-account values. Do NOT commit the filled-in
  copy, and do NOT include it in a deploy — web.config references it via
  <appSettings file="cw-secrets.config">, so leaving it out of the deploy is
  what keeps the credentials from being overwritten by each publish.
-->
<appSettings>
  <add key="CW_USERNAME" value="" />
  <add key="CW_PASSWORD" value="" />
</appSettings>
