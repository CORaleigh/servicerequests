# Copy this file to .env.local and fill in real values for local development.
# These are only used by the Vite dev-server proxy (vite.config.js).
# They are NOT embedded in the built JS bundle.
# In production, set credentials in public/web.config appSettings instead.
CW_USERNAME=
CW_PASSWORD=

# Sub-path the production build is served from — must start and end with "/".
# Only read at build time. Defaults to /servicerequests/ when unset.
# BASE_PATH=/servicerequests/
